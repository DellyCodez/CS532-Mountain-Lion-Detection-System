# Virtual Environments
venv/
.venv/
env/
ENV/

# Python Cache & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.dylib
*.so
*.dll

# IDE-specific local settings (already-tracked .idea files need a separate reviewed cleanup)
.idea/

# Datasets & Large Media
my_dataset/
*.wav
*.mp4
*.avi
*.jpg
*.png
*.zip

# Allow design and report screenshots/diagrams within project documentation
!docs/**/*.jpg
!docs/**/*.png

# Machine Learning Models & Weights
*.pt
*.onnx
*.h5
*.tflite
certificate.pem
